# Set these with `supabase secrets set` for hosted Edge Functions.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_MAPS_API_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
# Integer credits granted per whole currency unit (for example, per NGN).
CREDITS_PER_CURRENCY_UNIT=
# Public app origin used for the Paystack return URL, for example https://app.example.com.
APP_URL=
# Must match the SMTP dispatcher secret stored in Supabase Vault.
SMTP_DISPATCHER_SECRET=
